  <footer>
    <div class="nav-left" id="btn-bar"></div>
    <div class="nav-controls">
      <button class="btn-nav" onclick="navigateRelative(-1)">◀ Previous</button>
      <button class="btn-nav" onclick="navigateRelative(1)">Next ▶</button>
      <button class="btn-nav btn-review" onclick="toggleReview()">Review</button>
      <button class="btn-nav btn-submit" onclick="confirmSubmission()">Submit All</button>
    </div>
  </footer>

  <!-- PRINTABLE COMPREHENSIVE REPORT (@media print) -->
  <div id="printable-report">
    <div class="print-header">
      <div class="print-title">IELTS Academic Reading: TFNG &amp; YNNG Diagnostic Report</div>
      <div class="print-meta">
        <div><strong>Candidate:</strong> <span id="print-candidate-name">--</span></div>
        <div><strong>Date:</strong> <span id="print-date">--</span></div>
        <div><strong>Overall Score:</strong> <span id="print-raw">--</span> (<span id="print-band">Band --</span>)</div>
      </div>
    </div>
    <table class="print-table">
      <thead>
        <tr>
          <th>Q#</th>
          <th>Passage Section</th>
          <th>Task Type</th>
          <th>Candidate Answer</th>
          <th>Official Key</th>
          <th>Result</th>
        </tr>
      </thead>
      <tbody id="print-table-body">
        <!-- Rendered via JS -->
      </tbody>
    </table>
  </div>

  <script>
    // CORE ASSESSMENT DATA & STATE
    const ANSWER_KEYS = {
      1: "FALSE", 2: "TRUE", 3: "TRUE", 4: "NOT GIVEN", 5: "TRUE",
      6: "TRUE",  7: "FALSE", 8: "NOT GIVEN", 9: "TRUE", 10: "TRUE",
      11: "YES",  12: "NO", 13: "NOT GIVEN", 14: "YES", 15: "NO"
    };

    const TOTAL_QUESTIONS = 15;
    const userAnswers = {};
    const flagged = {};
    let activeSection = 1;
    let activeQuestion = 1;
    let timerInterval = null;
    let timeLeft = 30 * 60; // 30 minutes in seconds
    let candidateName = "Candidate";

    // INITIALIZE QUESTION DOCK
    const btnBar = document.getElementById('btn-bar');
    for (let q = 1; q <= TOTAL_QUESTIONS; q++) {
      const b = document.createElement('button');
      b.className = 'q-btn' + (q === 1 ? ' selected' : '');
      b.id = `qbtn-${q}`;
      b.textContent = `Q${q}`;
      b.onclick = () => jumpToQuestion(q);
      btnBar.appendChild(b);
    }

    // STAGE 1: START ASSESSMENT
    function startAssessment() {
      const nameInput = document.getElementById('candidate-name-input').value.trim();
      candidateName = nameInput || "Candidate";
      
      const sanitized = candidateName.replace(/[^a-zA-Z0-9_-]/g, '_');
      document.title = `${sanitized}_IELTS_READING_TFNG_YNNG`;
      document.getElementById('display-candidate-name').textContent = `Candidate: ${candidateName}`;
      
      document.getElementById('stage-intro').style.display = 'none';
      startTimer();
      focusQuestion(1);
    }

    // COUNTDOWN TIMER
    function startTimer() {
      const timerEl = document.getElementById('timer');
      timerInterval = setInterval(() => {
        timeLeft--;
        if (timeLeft <= 0) {
          clearInterval(timerInterval);
          timeLeft = 0;
          timerEl.textContent = "00:00";
          alert("Time has expired. Submitting your examination automatically.");
          evaluateTest();
          return;
        }

        const m = Math.floor(timeLeft / 60);
        const s = timeLeft % 60;
        timerEl.textContent = `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;

        if (timeLeft <= 300) {
          timerEl.classList.add('danger');
        }
      }, 1000);
    }

    // SECTION & QUESTION NAVIGATION
    function switchSection(secNum) {
      activeSection = secNum;
      for (let s = 1; s <= 3; s++) {
        document.getElementById(`tab-${s}`).classList.toggle('active', s === secNum);
        document.getElementById(`passage-sec-${s}`).classList.toggle('active', s === secNum);
        document.getElementById(`questions-sec-${s}`).classList.toggle('active', s === secNum);
      }
      document.getElementById('passage-pane').scrollTop = 0;
      document.getElementById('questions-pane').scrollTop = 0;
    }

    function jumpToQuestion(qNum) {
      const targetSec = qNum <= 5 ? 1 : (qNum <= 10 ? 2 : 3);
      if (activeSection !== targetSec) {
        switchSection(targetSec);
      }
      focusQuestion(qNum);
    }

    function focusQuestion(qNum) {
      activeQuestion = qNum;
      document.querySelectorAll('.q-btn').forEach(b => b.classList.remove('selected'));
      document.getElementById(`qbtn-${qNum}`)?.classList.add('selected');

      document.querySelectorAll('.question-item').forEach(qi => qi.classList.remove('active-focus'));
      const qBox = document.getElementById(`q-box-${qNum}`);
      if (qBox) {
        qBox.classList.add('active-focus');
        const qPane = document.getElementById('questions-pane');
        qPane.scrollTo({ top: qBox.offsetTop - qPane.offsetTop - 14, behavior: 'smooth' });
      }
    }

    function navigateRelative(delta) {
      let target = activeQuestion + delta;
      if (target < 1) target = 1;
      if (target > TOTAL_QUESTIONS) target = TOTAL_QUESTIONS;
      jumpToQuestion(target);
    }

    // ANSWER SELECTION HANDLER
    function setAnswer(qNum, val) {
      userAnswers[qNum] = val;
      
      const parentBox = document.getElementById(`q-box-${qNum}`);
      parentBox.querySelectorAll('.tfng-option-label').forEach(lbl => lbl.classList.remove('checked'));
      document.getElementById(`lbl-q${qNum}-${val}`)?.classList.add('checked');

      const btn = document.getElementById(`qbtn-${qNum}`);
      if (val) btn?.classList.add('answered');
      else btn?.classList.remove('answered');
    }

    function toggleReview() {
      flagged[activeQuestion] = !flagged[activeQuestion];
      document.getElementById(`qbtn-${activeQuestion}`)?.classList.toggle('flagged', flagged[activeQuestion]);
    }

    // HIGHLIGHTER SYSTEM
    function highlightSelectedText() {
      const sel = window.getSelection();
      if (!sel.rangeCount || sel.isCollapsed) return;

      const range = sel.getRangeAt(0);
      const passagePane = document.getElementById('passage-pane');
      if (!passagePane.contains(range.commonAncestorContainer)) {
        alert("Please select text inside the reading passage pane.");
        return;
      }

      const mark = document.createElement('mark');
      mark.className = 'user-highlight';
      try {
        range.surroundContents(mark);
      } catch (e) {
        const fragment = range.extractContents();
        mark.appendChild(fragment);
        range.insertNode(mark);
      }
      sel.removeAllRanges();
    }

    function clearHighlightsInActivePassage() {
      const activePassage = document.getElementById(`passage-sec-${activeSection}`);
      if (!activePassage) return;
      const marks = activePassage.querySelectorAll('mark.user-highlight');
      marks.forEach(m => {
        const parent = m.parentNode;
        while (m.firstChild) parent.insertBefore(m.firstChild, m);
        parent.removeChild(m);
      });
    }

    // SUBMISSION & SCORE COMPUTATION
    function confirmSubmission() {
      const answeredCount = Object.values(userAnswers).filter(v => v).length;
      const unanswered = TOTAL_QUESTIONS - answeredCount;
      if (unanswered > 0) {
        const proceed = confirm(`You still have ${unanswered} unanswered question(s). Are you sure you wish to submit the exam?`);
        if (!proceed) return;
      } else {
        const proceed = confirm("Are you ready to submit your exam?");
        if (!proceed) return;
      }
      evaluateTest();
    }

    function evaluateTest() {
      clearInterval(timerInterval);
      let rawScore = 0;
      for (let q = 1; q <= TOTAL_QUESTIONS; q++) {
        if (userAnswers[q] && userAnswers[q].toUpperCase() === ANSWER_KEYS[q].toUpperCase()) {
          rawScore++;
        }
      }

      // Band estimation calculated for 15-item module
      let bandScore = 3.5;
      if (rawScore >= 14) bandScore = 9.0;
      else if (rawScore >= 13) bandScore = 8.5;
      else if (rawScore >= 12) bandScore = 8.0;
      else if (rawScore >= 10) bandScore = 7.5;
      else if (rawScore >= 9) bandScore = 7.0;
      else if (rawScore >= 8) bandScore = 6.5;
      else if (rawScore >= 6) bandScore = 6.0;
      else if (rawScore >= 5) bandScore = 5.5;
      else if (rawScore >= 4) bandScore = 5.0;

      // Populate Score Modal
      document.getElementById('score-candidate-name').textContent = candidateName;
      document.getElementById('score-band').textContent = `Band ${bandScore.toFixed(1)}`;
      document.getElementById('score-raw').textContent = `${rawScore} / ${TOTAL_QUESTIONS}`;
      document.getElementById('score-correct').textContent = rawScore;
      document.getElementById('score-incorrect').textContent = TOTAL_QUESTIONS - rawScore;
      document.getElementById('stage-score').style.display = 'flex';

      // Populate Print Report
      document.getElementById('print-candidate-name').textContent = candidateName;
      document.getElementById('print-date').textContent = new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
      document.getElementById('print-raw').textContent = `${rawScore} / ${TOTAL_QUESTIONS}`;
      document.getElementById('print-band').textContent = `Band ${bandScore.toFixed(1)}`;

      const tableBody = document.getElementById('print-table-body');
      tableBody.innerHTML = '';
      for (let q = 1; q <= TOTAL_QUESTIONS; q++) {
        const sec = q <= 5 ? 1 : (q <= 10 ? 2 : 3);
        const taskType = sec <= 2 ? 'TFNG' : 'YNNG';
        const userVal = userAnswers[q] ? userAnswers[q].toUpperCase() : "BLANK";
        const keyVal = ANSWER_KEYS[q].toUpperCase();
        const isCorrect = userVal === keyVal;

        const row = document.createElement('tr');
        row.innerHTML = `
          <td><strong>Q${q}</strong></td>
          <td>Section ${sec}</td>
          <td>${taskType}</td>
          <td>${userVal}</td>
          <td><strong>${keyVal}</strong></td>
          <td class="${isCorrect ? 'print-correct' : 'print-incorrect'}">${isCorrect ? '✓ Correct' : '✗ Incorrect'}</td>
        `;
        tableBody.appendChild(row);
      }
    }

    function closeScoreModal() {
      document.getElementById('stage-score').style.display = 'none';
    }

    // TEACHER PASSCODE SYSTEM
    function openPasscodeModal() {
      document.getElementById('stage-score').style.display = 'none';
      document.getElementById('passcode-input').value = '';
      document.getElementById('pwd-error').style.display = 'none';
      document.getElementById('pwd-modal').style.display = 'flex';
    }

    function closePasscodeModal() {
      document.getElementById('pwd-modal').style.display = 'none';
      document.getElementById('stage-score').style.display = 'flex';
    }

    function togglePasswordVisibility() {
      const pwd = document.getElementById('passcode-input');
      const chk = document.getElementById('show-pwd-toggle');
      pwd.type = chk.checked ? 'text' : 'password';
    }

    function validatePasscode() {
      const code = document.getElementById('passcode-input').value.trim();
      if (code === "sezad13005") {
        document.body.classList.add('solution-active');
        document.getElementById('pwd-modal').style.display = 'none';
        alert("Teacher breakdown mode unlocked successfully. Sentence-level evidence anchors, sequential zones, and trap breakdowns are now visible.");
      } else {
        document.getElementById('pwd-error').style.display = 'block';
      }
    }

    // JUMP TO EVIDENCE
    function jumpToEvidence(evidenceId, secNum) {
      if (activeSection !== secNum) switchSection(secNum);
      const target = document.getElementById(evidenceId);
      const pane = document.getElementById('passage-pane');
      if (target && pane) {
        pane.scrollTo({ top: target.offsetTop - pane.offsetTop - 20, behavior: 'smooth' });
        target.classList.add('flash');
        setTimeout(() => target.classList.remove('flash'), 1400);
      }
    }
  </script>
</body>
</html>
